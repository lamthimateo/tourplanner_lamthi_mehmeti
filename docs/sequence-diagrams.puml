@startuml Tour Planner — Sequence Diagrams

skinparam sequence {
    BackgroundColor #0b0e14
    ParticipantBackgroundColor #1e2330
    ParticipantBorderColor #4a90d9
    ParticipantFontColor #e6e6e6
    ArrowColor #4a90d9
    LifeLineBorderColor #4a90d9
    LifeLineBackgroundColor #1e2330
    NoteBackgroundColor #2a3040
    NoteBorderColor #4a90d9
    NoteFontColor #e6e6e6
}

' ═══════════════════════════════════════════════════════════════════════
' SD 1: User Registration and Login
' ═══════════════════════════════════════════════════════════════════════
title SD-1: Register and Login

actor User
participant "Angular\nAppComponent\n(View)" as View
participant "AuthService\n(ViewModel layer)" as AS
participant "AuthController\n(Web layer)" as AC
participant "AuthService\n(Service layer)" as BS
participant "UserRepository\n(DAL)" as UR
participant "JwtUtil\n(Security)" as JWT
database "PostgreSQL" as DB

User -> View: Fill username + password\nClick Register
View -> AS: register({ username, password })
AS -> AC: POST /api/auth/register
AC -> BS: register(AuthRequest)
BS -> UR: existsByUsername(username)
UR -> DB: SELECT COUNT(*) FROM app_user
DB --> UR: 0
UR --> BS: false
BS -> BS: BCrypt.encode(password)
BS -> UR: save(User)
UR -> DB: INSERT INTO app_user ...
DB --> UR: saved User
UR --> BS: User{id, username}
BS -> JWT: generateToken(username, userId)
JWT --> BS: "eyJ..."
BS --> AC: AuthResponse{token, username}
AC --> AS: 200 OK {token, username}
AS -> AS: localStorage.setItem('token', ...)
AS --> View: success
View -> View: reloadTours()
View --> User: Main app shown

note over View, JWT
  Subsequent requests include:
  Authorization: Bearer eyJ...
  (added by authInterceptor)
end note

newpage SD-2: Calculate Route

' ═══════════════════════════════════════════════════════════════════════
' SD 2: Calculate Route
' ═══════════════════════════════════════════════════════════════════════
title SD-2: Calculate Route

actor User
participant "AppComponent\n(View)" as View
participant "ApiService" as API
participant "RouteController\n(Web layer)" as RC
participant "OpenRouteService\n(Service layer)" as ORS
participant "OpenRouteService\nAPI (external)" as ORSA
participant "Leaflet Map\n(DOM)" as Map

User -> View: Fill origin + destination\nClick "Calculate route"
View -> API: getCoordinates(origin)
API -> RC: GET /api/route/coordinates?location=Vienna
RC -> ORS: getCoordinates("Vienna")
ORS -> ORSA: GET .../geocode/search?text=Vienna
ORSA --> ORS: GeoJSON FeatureCollection
ORS --> RC: [lat, lng]
RC --> API: [48.2082, 16.3738]
API --> View: [fromLat, fromLng]

View -> API: getCoordinates(destination)
API -> RC: GET /api/route/coordinates?location=Salzburg
RC -> ORS: getCoordinates("Salzburg")
ORS -> ORSA: GET .../geocode/search?text=Salzburg
ORSA --> ORS: GeoJSON FeatureCollection
ORS --> RC: [lat, lng]
RC --> API: [47.8095, 13.0550]
API --> View: [toLat, toLng]

View -> API: getRoute(fromLat, fromLng, toLat, toLng)
API -> RC: GET /api/route?fromLat=...
RC -> ORS: getRoute(fromLat, fromLng, toLat, toLng)
ORS -> ORSA: POST .../v2/directions/car
ORSA --> ORS: GeoJSON with geometry + summary
ORS --> RC: GeoJSON FeatureCollection
RC --> API: GeoJSON
API --> View: routeJson

View -> View: Extract coordinates array\nUpdate distance + estimatedTime in TourViewModel
View -> Map: drawRoute(latLngs, fromMarker, toMarker)
Map --> View: polyline rendered
View --> User: Map shows route\nDistance + time fields updated

newpage SD-3: Save Tour Log

' ═══════════════════════════════════════════════════════════════════════
' SD 3: Save Tour Log
' ═══════════════════════════════════════════════════════════════════════
title SD-3: Save Tour Log (Create)

actor User
participant "AppComponent\n(View)" as View
participant "TourLogViewModel" as TLVM
participant "ApiService" as API
participant "TourController\n(Web layer)" as TC
participant "TourLogService\n(Service layer)" as TLS
participant "TourLogRepository\n(DAL)" as TLR
database "PostgreSQL" as DB

User -> View: Click "+ New log"
View -> TLVM: new TourLogViewModel()
TLVM --> View: editingLog (defaults set)
View --> User: Log form shown

User -> View: Fill logDate, comment,\ndifficulty, rating, etc.
note over View, TLVM: [(ngModel)] binds directly\nto TourLogViewModel fields

User -> View: Click "Save log"
View -> TLVM: submitted = true
View -> TLVM: isValid()
TLVM --> View: true

View -> TLVM: toLog()
TLVM --> View: TourLog{ logDate, comment, ... }

View -> API: createLog(tourId, log)
API -> TC: POST /api/tours/{tourId}/logs
TC -> TLS: createTourLog(tourId, tourLog)
TLS -> TLR: findById(tourId) — check tour exists
TLR -> DB: SELECT * FROM tour WHERE id=?
DB --> TLR: Tour
TLR --> TLS: Tour
TLS -> TLR: save(tourLog)
TLR -> DB: INSERT INTO tour_log ...
DB --> TLR: saved TourLog
TLR --> TLS: TourLog{id, ...}
TLS --> TC: TourLog
TC --> API: 200 OK TourLog
API --> View: TourLog

View -> View: editingLog = null\nloadLogs()\nreloadTours()
View --> User: Log list updated\nTour popularity/childFriendliness refreshed

newpage SD-4: Export and Import Tour

' ═══════════════════════════════════════════════════════════════════════
' SD 4: Export Tour as JSON
' ═══════════════════════════════════════════════════════════════════════
title SD-4: Export and Import Tour

actor User
participant "AppComponent\n(View)" as View
participant "ApiService" as API
participant "TourController\n(Web layer)" as TC
participant "TourDataTransferService\n(Service layer)" as TDTS
participant "TourRepository / TourLogRepository\n(DAL)" as Repo
database "PostgreSQL" as DB
participant "Browser\nFilesystem" as FS

== Export ==

User -> View: Click "Export JSON"
View -> API: exportTour(tourId)
API -> TC: GET /api/tours/{tourId}/export
TC -> TDTS: exportTourData(tourId)
TDTS -> Repo: findById(tourId)\nfindByTourId(tourId)
Repo -> DB: SELECT tour + logs
DB --> Repo: Tour, List<TourLog>
Repo --> TDTS: data
TDTS --> TC: TourExportDto{tour, logs}
TC --> API: 200 OK JSON
API --> View: TourExportDto

View -> FS: Create Blob → download tour_42.json
FS --> User: File download triggered

== Import ==

User -> View: Click "Import"\nSelect tour_42.json
View -> View: FileReader.readAsText(file)
View -> View: JSON.parse(result)
View -> API: importTour(parsedData)
API -> TC: POST /api/tours/import
TC -> TDTS: importTourData(TourExportDto)
TDTS -> TDTS: Set userId from AuthContext\nAssign new IDs
TDTS -> Repo: save(tour)\nsave(logs)
Repo -> DB: INSERT tour + logs
DB --> Repo: saved entities
Repo --> TDTS: Tour
TDTS --> TC: Tour
TC --> API: 200 OK Tour
API --> View: Tour

View -> View: reloadTours()\nselectTour(imported)
View --> User: Imported tour selected and shown

@enduml
