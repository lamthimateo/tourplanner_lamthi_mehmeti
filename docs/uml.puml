@startuml Tour Planner — Class Diagram

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #1e2330
    BorderColor #4a90d9
    FontColor #e6e6e6
    ArrowColor #4a90d9
}

' ─────────────────────────────────────────────
'  DOMAIN MODEL
' ─────────────────────────────────────────────

package "model" {

    class User {
        - id : Long
        - username : String
        - password : String
        + getId() : Long
        + getUsername() : String
        + getPassword() : String
        + setId(Long) : void
        + setUsername(String) : void
        + setPassword(String) : void
    }

    class Tour {
        - id : Long
        - userId : Long
        - name : String
        - description : String
        - origin : String
        - destination : String
        - transportType : String
        - distance : Double
        - estimatedTime : Integer
        - imagePath : String
        + getters / setters
    }

    class TourLog {
        - id : Long
        - tourId : Long
        - logDate : String
        - comment : String
        - difficulty : Integer
        - totalDistance : Double
        - totalTimeMinutes : Integer
        - rating : Integer
        + getters / setters
    }

    Tour "1" --> "0..*" TourLog : has
    User "1" --> "0..*" Tour : owns
}

' ─────────────────────────────────────────────
'  REPOSITORIES
' ─────────────────────────────────────────────

package "repository" {

    interface TourRepository {
        + findByUserId(Long) : List<Tour>
        + findByIdAndUserId(Long, Long) : Optional<Tour>
        + existsByIdAndUserId(Long, Long) : boolean
    }

    interface TourLogRepository {
        + findByTourId(Long) : List<TourLog>
    }

    interface UserRepository {
        + findByUsername(String) : Optional<User>
        + existsByUsername(String) : boolean
    }
}

' ─────────────────────────────────────────────
'  SERVICES
' ─────────────────────────────────────────────

package "service" {

    class TourService {
        - tourRepository : TourRepository
        - tourLogRepository : TourLogRepository
        + getAllTours() : List<Tour>
        + getTourById(Long) : Tour
        + createTour(Tour) : Tour
        + updateTour(Tour) : Tour
        + deleteTour(Long) : void
        + computePopularity(Long) : int
        + computeChildFriendliness(Long) : double
        + searchTourIds(String) : List<Long>
    }

    class TourLogService {
        - tourLogRepository : TourLogRepository
        - tourRepository : TourRepository
        + getAllTourLogs(Long) : List<TourLog>
        + createTourLog(Long, TourLog) : TourLog
        + updateTourLog(Long, TourLog) : TourLog
        + deleteTourLog(Long, Long) : void
    }

    class AuthService {
        - userRepository : UserRepository
        - passwordEncoder : BCryptPasswordEncoder
        - jwtUtil : JwtUtil
        + register(AuthRequest) : AuthResponse
        + login(AuthRequest) : AuthResponse
    }

    class StatsService {
        - tourRepository : TourRepository
        - tourLogRepository : TourLogRepository
        + getStats() : StatsDto
    }

    class ReportService {
        + generateTourReport(Tour) : Path
        + generateSummaryReport(List<Tour>) : Path
    }

    class TourDataTransferService {
        - tourRepository : TourRepository
        - tourLogRepository : TourLogRepository
        + exportTourData(Long) : TourExportDto
        + importTourData(TourExportDto) : Tour
    }

    class OpenRouteService {
        + getCoordinates(String) : double[]
        + getRoute(double, double, double, double) : String
    }

    TourService --> TourRepository
    TourService --> TourLogRepository
    TourLogService --> TourLogRepository
    TourLogService --> TourRepository
    AuthService --> UserRepository
    StatsService --> TourRepository
    StatsService --> TourLogRepository
    TourDataTransferService --> TourRepository
    TourDataTransferService --> TourLogRepository
}

' ─────────────────────────────────────────────
'  SECURITY
' ─────────────────────────────────────────────

package "security" {

    class JwtUtil {
        - secret : String
        - expirationMs : long
        + generateToken(String, Long) : String
        + getUsername(String) : String
        + getUserId(String) : Long
        + isValid(String) : boolean
    }

    class JwtAuthFilter {
        - jwtUtil : JwtUtil
        + doFilterInternal(req, res, chain) : void
    }

    class SecurityConfig {
        + securityFilterChain(HttpSecurity) : SecurityFilterChain
        + passwordEncoder() : BCryptPasswordEncoder
    }

    class AuthContext {
        + {static} getCurrentUserId() : Long
    }

    JwtAuthFilter --> JwtUtil
    AuthService --> JwtUtil
}

' ─────────────────────────────────────────────
'  WEB LAYER
' ─────────────────────────────────────────────

package "web" {

    class TourController {
        + getAllTours() : List<TourResponseDto>
        + getTour(Long) : TourResponseDto
        + createTour(Tour) : TourResponseDto
        + updateTour(Long, Tour) : TourResponseDto
        + deleteTour(Long) : void
        + searchTours(String) : List<Long>
        + exportTour(Long) : TourExportDto
        + importTour(TourExportDto) : TourResponseDto
        + getTourLogs(Long) : List<TourLog>
        + createTourLog(Long, TourLog) : TourLog
        + updateTourLog(Long, Long, TourLog) : TourLog
        + deleteTourLog(Long, Long) : void
        + downloadTourReport(Long) : byte[]
        + downloadSummaryReport() : byte[]
    }

    class AuthController {
        + register(AuthRequest) : AuthResponse
        + login(AuthRequest) : AuthResponse
    }

    class StatsController {
        + getStats() : StatsDto
    }

    class RouteController {
        + getCoordinates(String) : double[]
        + getRoute(double, double, double, double) : String
    }

    class ApiExceptionHandler {
        + handleValidation(MethodArgumentNotValidException) : ErrorResponse
        + handleIllegal(IllegalArgumentException) : ErrorResponse
    }

    TourController --> TourService
    TourController --> TourLogService
    TourController --> ReportService
    TourController --> TourDataTransferService
    AuthController --> AuthService
    StatsController --> StatsService
    RouteController --> OpenRouteService
}

' ─────────────────────────────────────────────
'  DTOs
' ─────────────────────────────────────────────

package "dto" {

    class TourResponseDto {
        + id : Long
        + name : String
        + description : String
        + origin : String
        + destination : String
        + transportType : String
        + distance : Double
        + estimatedTime : Integer
        + imagePath : String
        + popularity : int
        + childFriendliness : double
    }

    class TourExportDto {
        + tour : TourDto
        + logs : List<LogDto>
    }

    class StatsDto {
        + totalTours : int
        + totalLogs : int
        + totalDistanceKm : double
        + totalTimeHours : double
        + avgRating : double
        + byTransportType : List<TransportStat>
    }

    class AuthRequest {
        + username : String
        + password : String
    }

    class AuthResponse {
        + token : String
        + username : String
    }
}

@enduml
