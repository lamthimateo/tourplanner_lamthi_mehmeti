# Copy this file to backend/.env and fill in values.
# .env is gitignored so real secrets never reach the repository.

# --- OpenRouteService ---
# Create a free API key at https://openrouteservice.org/sign-up
ORS_API_KEY=

# --- PostgreSQL Database ---
# Defaults below match the values used by docker-compose.yml in the repo root.
# Change username / password / host if you run PostgreSQL elsewhere.
DB_URL=jdbc:postgresql://localhost:5432/tourplanner
DB_USERNAME=tourplanner
DB_PASSWORD=tourplanner

# --- JWT (optional overrides) ---
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRATION_MS=86400000

# --- Server ---
# SERVER_PORT=8081
